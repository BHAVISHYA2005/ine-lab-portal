{
  "name": "ine-lab-portal-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ine-lab-portal-db --local --file=src/schemas/schema.sql",
    "db:migrate:ai:local": "wrangler d1 execute ine-lab-portal-db --local --file=src/schemas/002_ai_review.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.0.0",
    "jose": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
